# Copy to .env for local runs. On Render, put these in the "clipforge-secrets" env group instead.
# NEVER commit .env or paste these into chat.

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# YouTube Data API key (free, Google Cloud console) — optional but improves discovery & viewer counts
YOUTUBE_API_KEY=

# Buffer → publish.buffer.com/settings/api ; channel id from: python -m worker.tools.buffer_setup
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=

# Capture ladder (only add when the capture test says you need them)
# C2: base64 of a Netscape cookies.txt exported from a BURNER Google account: base64 -i cookies.txt
YTDLP_COOKIES_B64=
# C3: static ISP proxy, e.g. http://user:pass@host:port
YTDLP_PROXY=
CAPTURE_LEVEL=auto

# Claude wake-up (event-driven): fine-grained GitHub token with Issues: read & write on this repo
WAKE_METHOD=github_issue
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_WAKE_ISSUE=1

# Tuning
WHISPER_MODEL=base.en
REC_MAX_HEIGHT=1080
RING_MINUTES=12
