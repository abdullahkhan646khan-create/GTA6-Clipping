{
  "detector": {
    "window_s": 10,
    "baseline_s": 300,
    "weights": { "chat": 35, "hype": 15, "audio": 35, "viewers": 15 },
    "candidate_threshold": 60,
    "cooldown_s": 90,
    "post_roll_s": 15,
    "pre_roll_s": 40,
    "default_chat_delay_s": 5,
    "audio_spike_db": 8,
    "hype_keywords": ["lmao", "lol", "lmfao", "😂", "💀", "😭", "kekw", "omegalul", "no way", "bro", "clip", "clip it",
                      "wtf", "holy", "???", "!!!", "w", "l", "insane", "nahh", "nah", "deadass", "bruh", "omg"]
  },
  "scoring": {
    "edit_threshold": 70,
    "signal_weight": 0.4,
    "llm_weight": 0.6,
    "category_weights": {
      "first_reaction": 1.3, "glitch": 1.3, "rage": 1.25, "npc": 1.2,
      "police_chase": 1.1, "fail": 1.1, "clutch": 1.0, "easter_egg": 1.0,
      "banter": 0.9, "info": 0.7, "other": 0.8
    }
  },
  "cut": { "min_s": 15, "target_min_s": 25, "target_max_s": 35, "max_s": 58, "tail_s": 2.5, "word_pad_s": 0.15 },
  "build": {
    "width": 1080, "height": 1920, "fps": 30, "crf": 21, "maxrate": "6M",
    "lufs": -14, "true_peak": -1,
    "caption_font": "Montserrat ExtraBold", "caption_size": 86, "caption_outline": 8,
    "caption_color": "&H00FFFFFF", "caption_highlight": "&H0000E6FF",
    "max_words_per_caption": 3,
    "hook_seconds": 2.5, "credit_seconds": 3.0,
    "zoom": 1.12, "max_zooms": 2
  },
  "qa": { "pass": 85, "fix": 70, "max_fix_rounds": 1, "max_file_mb": 48 },
  "publish": {
    "require_permission": true,
    "auto_publish_min_final": 80,
    "auto_publish_min_qa": 90,
    "max_same_streamer_in_row": 2,
    "hashtags_base": ["#GTA6", "#GTAVI", "#Shorts"]
  },
  "title_formulas": [
    "{streamer} Wasn't Ready For {x} In GTA 6 😭",
    "GTA 6 {x} Is Actually Insane",
    "This GTA 6 {x} Broke {streamer}",
    "{streamer}'s First Time {x} In GTA 6",
    "Nobody Expected This In GTA 6…",
    "{streamer} Found {x} In GTA 6"
  ]
}
